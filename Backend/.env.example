# ---------------------------------------------------------------------------
# NovaCare backend — example environment configuration.
# Copy to `.env` and adjust. All values below are the in-code defaults, so the
# app runs out of the box for local development without any .env at all.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME=NovaCare
APP_ENV=dev                 # dev | staging | prod
DEBUG=true
API_PREFIX=                 # leave empty; routers are already namespaced

# --- Auth / JWT ---
JWT_SECRET=dev-insecure-change-me      # CHANGE in production
JWT_ALGORITHM=HS256
ASHA_TOKEN_EXPIRE_HOURS=12
PATIENT_TOKEN_EXPIRE_HOURS=24
DOCTOR_TOKEN_EXPIRE_HOURS=12

# --- OTP (patient login) ---
OTP_LENGTH=6
OTP_TTL_SECONDS=300         # 5 minutes

# --- MongoDB (cloud, synced records + heatmap aggregates) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=novacare

# --- SQLite (offline-first on-device mirror) ---
SQLITE_URL=sqlite+aiosqlite:///./novacare_local.db

# --- CORS (comma-separated allowed frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- SMS gateway ---
SMS_PROVIDER=mock           # mock | msg91 | twilio
SMS_API_KEY=
SMS_SENDER_ID=NOVCRE
TWILIO_FROM=

# --- Push notifications (FCM) ---
FCM_PROVIDER=mock           # mock | fcm
FCM_SERVER_KEY=

# --- Text-to-speech ---
TTS_PROVIDER=mock           # mock | coqui | google
TTS_OUTPUT_DIR=./data/tts_cache

# --- Follow-up / scheduling ---
MISSED_FOLLOWUP_DAYS=21

# --- Knowledge base / i18n paths ---
DIET_KB_PATH=data/diet_advice.json
TRANSLATIONS_DIR=data/translations
